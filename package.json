{
  "name": "flowy-companion",
  "productName": "Flowy",
  "version": "0.1.0",
  "description": "Flowy – an anime desktop companion for Windows that talks (Fish TTS), listens (push-to-talk), sees your screen and helps you like a Jarvis.",
  "main": "./out/main/index.js",
  "author": "Flowy contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "setup:live2d": "node scripts/setup-live2d.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@mozilla/readability": "^0.6.0",
    "@msgpack/msgpack": "^3.1.3",
    "html-to-text": "^10.0.1",
    "linkedom": "^0.18.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pixi-live2d-display-lipsyncpatch": "0.5.0-ls-8",
    "pixi.js": "^7.4.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
